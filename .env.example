# Copy this file to .env. Never commit .env.

# For an OpenAI-compatible provider configured in configs/config.yaml:
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=

# Or use the standard OpenAI environment variable names:
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
